# Your OpenRouter key, for the CLI. The web app doesn't use it: each account
# connects its own key in Settings. orch never logs keys.
OPENROUTER_API_KEY=

# Postgres for accounts, runs, events and the job queue. Start it with `pnpm db:up`.
# Leave unset to use an embedded Postgres (PGlite) stored in .orch/db.
# DATABASE_URL=postgres://orch:orch@localhost:5433/orch

# The master key that encrypts stored API keys: 32 bytes, base64.
# Make one with: openssl rand -base64 32
# Locally, leave it unset and `orch serve` makes one in .orch/master.key.
# To rotate, list versions newest first: ORCH_MASTER_KEYS=2:newkey,1:oldkey
# ORCH_MASTER_KEY=

# Set to 1 when the app is served over HTTPS, so session cookies are Secure.
# ORCH_SECURE_COOKIES=1
