{
  "name": "orch",
  "version": "0.1.0",
  "private": true,
  "description": "Draft a tree of steps for a goal, cast roles and models, and watch it run.",
  "type": "module",
  "bin": {
    "orch": "dist/cli/main.js"
  },
  "scripts": {
    "orch": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.9",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
